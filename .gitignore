# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables — ignore ALL env files (they hold secrets), keep only the
# committed template. deploy.sh regenerates .env.production from .env on the server,
# so it must never be tracked (it would carry RESEND/ANTHROPIC/etc. into git).
.env
.env.*
!.env.example

# DB-backed abuse controls for /api/mesa (rate-limit + spend ledger).
# Persistent SQLite state — never commit it; production uses ME_DATA_DIR outside the repo.
data
server/data
*.db
*.db-shm
*.db-wal

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
