# ── Analytics & SEO ──────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (get from analytics.google.com)
# Format: G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification code (get from search.google.com/search-console)
# Paste the content value from the <meta name="google-site-verification"> tag
VITE_GSC_VERIFICATION=

# ── Google Places API — for live Google Reviews on homepage ──────────────────
# Enable "Places API" in Google Cloud Console (same project as YouTube & GA4)
# Find your Place ID at: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACES_API_KEY=AIzaSy...
GOOGLE_PLACE_ID=CbfRQR7cmAJtEcrKkAhVA5Xr

# ── Claude API key — required for MESA AI chat
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── MESA abuse controls (/api/mesa) — all optional, safe defaults shown ───────
# /api/mesa is public + unauthenticated + calls the PAID Claude API, so it is
# rate-limited and spend-capped (DB-backed in server/store.js). Tune per traffic.
# ME_DATA_DIR: where the SQLite control DB lives. In production set this OUTSIDE
# the repo so a git pull + rebuild can't wipe it (e.g. /var/lib/modern-explorer).
# ME_DATA_DIR=/var/lib/modern-explorer
# MESA_PER_IP=30        # messages per IP per rolling hour (429 over cap)
# MESA_GLOBAL=400       # messages per hour across all IPs (429 over cap)
# MESA_MAX_TURNS=24     # max messages in one conversation (400 over cap)
# MESA_MAX_CHARS=2000   # max chars per message (truncated)
# MESA_DAILY_USD=5      # hard daily Claude spend ceiling (503 over cap)
# MESA_MONTHLY_USD=50   # hard 30-day Claude spend ceiling (503 over cap)

# Gmail SMTP credentials
# Use a Gmail App Password (not your regular password).
# To create one: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: override the default port (3001)
# PORT=3001
